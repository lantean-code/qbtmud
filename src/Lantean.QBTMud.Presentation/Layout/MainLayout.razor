@inherits LayoutComponentBase

<div class="main-layout">
    <BreakpointOrientationProvider OnBreakpointChanged="BreakpointChanged">
        <CascadingValue Value="DrawerOpen" Name="DrawerOpen">
        <CascadingValue Value="DrawerOpenChangedCallback" Name="DrawerOpenChanged">
        <CascadingValue Value="TimerDrawerOpen" Name="TimerDrawerOpen">
        <CascadingValue Value="TimerDrawerOpenChangedCallback" Name="TimerDrawerOpenChanged">
            <EnhancedErrorBoundary @ref="ErrorBoundary" OnClear="Cleared">
                <MudThemeProvider @ref="MudThemeProvider" @bind-IsDarkMode="IsDarkMode" Theme="Theme" />
                <MudDialogProvider CloseOnEscapeKey="true" />
                <MudSnackbarProvider />
                <MudPopoverProvider />

            <PageTitle>@BuildPageTitle()</PageTitle>

            <MudLayout>
                <MudAppBar>
                    @if (ShowMenuButton)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="@AppBarTitleClass">
                        <MudImage Src="images/qbtmud-icon-transparent.svg" Alt="@LanguageLocalizer.Translate("AppAbout", "qbtmud")"
                                  Width="32" Height="32" ObjectFit="ObjectFit.Contain" Class="flex-shrink-0" data-test-id="@TestIdHelper.For("AppBarLogo")" />
                        <MudText Typo="Typo.h5">@AppBarTitle</MudText>
                    </MudStack>
                    <MudSpacer />
                    @if (ErrorBoundary?.Errors.Count > 0)
                    {
                        <MudBadge Content="@(ErrorBoundary?.Errors.Count ?? 0)" Color="Color.Error" Overlap="true" Class="mr-2">
                            <MudIconButton Icon="@Icons.Material.Filled.Error" Color="Color.Default" OnClick="ToggleErrorDrawer" />
                        </MudBadge>
                    }
                    <Menu @ref="Menu" />
                </MudAppBar>

                <MudDrawer @bind-Open="ErrorDrawerOpen" ClipMode="DrawerClipMode.Docked" Elevation="2" Anchor="Anchor.Right">
                    <ErrorDisplay ErrorBoundary="ErrorBoundary" />
                </MudDrawer>

                <MudDrawer @bind-Open="TimerDrawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Overlay="true" OverlayAutoClose="true" Class="app-shell__timer-drawer">
                    <TimerStatusPanel />
                </MudDrawer>

                <CascadingValue Value="Theme">
                <CascadingValue Value="IsDarkMode" Name="IsDarkMode">
                <CascadingValue Value="Menu">
                    @Body
                </CascadingValue>
                </CascadingValue>
                </CascadingValue>
            </MudLayout>
            </EnhancedErrorBoundary>
        </CascadingValue>
        </CascadingValue>
        </CascadingValue>
        </CascadingValue>
    </BreakpointOrientationProvider>
</div>
